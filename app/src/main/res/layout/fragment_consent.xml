<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Progress -->
        <include
                layout="@layout/view_onboarding_progress"
                android:layout_width="match_parent"
                android:layout_height="6dp" />


        <!-- top row -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageButton
                    android:id="@+id/consentBackButton"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_fitto_circle_white"
                    android:contentDescription="@string/back"
                    android:elevation="3dp"
                    android:padding="18dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/fitto_text_dark" />

            <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

            <LinearLayout
                    android:id="@+id/languageButton"
                    android:layout_width="wrap_content"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_fitto_chip_outline"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_language"
                        app:tint="@color/fitto_text_dark" />

                <TextView
                        android:id="@+id/languageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/language_turkish"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/ic_keyboard_arrow_down"
                        app:tint="@color/fitto_text_dark" />

            </LinearLayout>

        </LinearLayout>

        <!-- main card -->
        <LinearLayout
                android:id="@+id/consentMainCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_fitto_card_large"
                android:elevation="3dp"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

            <!-- top chip -->
            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_fitto_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/fitto_text_dark" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/consent_badge_text"                        android:textColor="@color/fitto_text_dark"
                        android:textSize="14sp" />

            </LinearLayout>

            <!-- title zone -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                <FrameLayout
                        android:layout_width="132dp"
                        android:layout_height="132dp">

                    <ImageView
                            android:id="@+id/consentIllustrationImage"
                            android:layout_width="132dp"
                            android:layout_height="132dp"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/consent_title"
                            android:scaleType="fitCenter"
                            android:src="@drawable/consent_security_illustration" />
                    <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:src="@drawable/ic_leaf"
                            android:alpha="0.75"
                            app:tint="#A4C87D" />

                </FrameLayout>

                <TextView
                        android:id="@+id/consentTitleText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:text="@string/consent_title"
                        android:textColor="#0F2C26"
                        android:textSize="24sp"
                        android:textStyle="bold" />

            </LinearLayout>

            <!-- desc row 1 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_fitto_circle_soft">

                    <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_leaf"
                            app:tint="@color/fitto_text_dark" />
                </FrameLayout>

                <TextView
                        android:id="@+id/consentDescOneText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/consent_intro_1"
                        android:textColor="#4F5458"
                        android:textSize="14sp" />

            </LinearLayout>

            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#E7ECE4" />

            <!-- desc row 2 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_fitto_circle_soft">

                    <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/fitto_text_dark" />
                </FrameLayout>

                <TextView
                        android:id="@+id/consentDescTwoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/consent_intro_2"
                        android:textColor="#4F5458"
                        android:textSize="14sp" />

            </LinearLayout>

            <!-- approval box -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_fitto_card_soft"
                    android:orientation="horizontal"
                    android:padding="16dp">

                <FrameLayout
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_circle_primary_soft">

                    <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_assignment_turned_in"
                            app:tint="@color/fitto_green" />
                </FrameLayout>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/consentApprovalTitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/consent_section_title"                            android:textColor="#0F2C26"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/consentApprovalDescText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/consent_body"                            android:textColor="#4F5458"
                            android:textSize="16sp" />

                    <TextView
                            android:id="@+id/consentAiPrivacyNoteText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/consent_ai_privacy_note"
                            android:textColor="#4F5458"
                            android:textSize="15sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- info strip -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_fitto_card_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="14dp">

                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/fitto_text_dark" />

                <TextView
                        android:id="@+id/consentInfoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/consent_settings_note"                        android:textColor="#5A5F63"
                        android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

            <LinearLayout
                    android:id="@+id/consentAcceptButton"                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_fitto_button_pill_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/consent_accept"                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                    android:id="@+id/consentDeclineButton"                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_fitto_button_pill_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/consent_decline"                        android:textColor="@color/fitto_green"
                        android:textSize="14sp"
                        android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>