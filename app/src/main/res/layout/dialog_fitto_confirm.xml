<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/fitto_surface"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

    <TextView
            android:id="@+id/confirmDialogTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fitto_text_on_light_surface"
            android:textSize="24sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/confirmDialogMessageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/fitto_text_secondary_on_light_surface"
            android:textSize="16sp" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmCancelButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:textAllCaps="false"
                android:textColor="@color/fitto_green"
                android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/confirmPositiveButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:textAllCaps="false"
                android:textColor="@color/fitto_green"
                android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
