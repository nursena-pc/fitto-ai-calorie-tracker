<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light">

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="32dp">

            <!-- ÜST BAR -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/app_name"
                            android:src="@drawable/fitto1_icon" />

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/fredoka_bold"
                            android:text="@string/app_name"
                            android:textColor="@color/fitto_green"
                            android:textSize="28sp" />
                </LinearLayout>

                <ImageButton
                        android:id="@+id/searchButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/diet_plans_search"
                        android:padding="9dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/fitto_text_dark" />

                <ImageButton
                        android:id="@+id/filterButton"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/diet_plans_filter"
                        android:padding="9dp"
                        android:src="@drawable/ic_filter_list"
                        app:tint="@color/fitto_text_dark" />
            </LinearLayout>

            <!-- BAŞLIK -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/diet_plans_title"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/diet_plans_subtitle"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dietPlanDisclaimerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/fitto_primary_soft"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fitto_divider_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                    <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_fitto_chip"
                            android:gravity="center"
                            android:text="i"
                            android:textColor="@color/fitto_green"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/diet_plans_health_disclaimer"
                            android:textColor="@color/fitto_text_secondary"
                            android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HERO CARD -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/todayDietHeroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/fitto_green"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diet_plans_hero_title"
                                android:textColor="@color/white"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/diet_plans_hero_subtitle"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/applyTodayDietButton"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="match_parent"
                                android:layout_height="68dp"
                                android:layout_marginTop="14dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:text="@string/diet_plans_apply_today"
                                android:textAllCaps="false"
                                android:textAlignment="center"
                                android:textColor="@color/fitto_green"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/white"
                                app:cornerRadius="28dp"
                                app:icon="@drawable/ic_keyboard_arrow_down"
                                app:iconGravity="textEnd"
                                app:iconPadding="8dp"
                                app:iconTint="@color/fitto_green" />
                    </LinearLayout>

                    <ImageView
                            android:layout_width="118dp"
                            android:layout_height="168dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitCenter"
                            android:src="@drawable/diyet_mascot" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CHIPLER - TEK SATIR ve KAYDIRILABİLİR -->
            <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                        android:id="@+id/planChipGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipReadyPlans"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:checkable="true"
                            android:text="@string/diet_plans_tab_ready"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/chip_selector_bg"
                            app:chipCornerRadius="18dp"
                            app:chipStrokeWidth="0dp"
                            android:textColor="@color/chip_selector_text"
                            app:textEndPadding="16dp"
                            app:textStartPadding="16dp" />

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipMyPlans"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diet_plans_tab_my"
                            app:checkedIconVisible="false"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_selector_bg"
                            app:chipCornerRadius="18dp"
                            app:chipStrokeWidth="0dp"
                            android:textColor="@color/chip_selector_text"
                            app:textEndPadding="16dp"
                            app:textStartPadding="16dp" />

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipFavorites"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diet_plans_tab_favorites"
                            app:checkedIconVisible="false"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_selector_bg"
                            app:chipCornerRadius="18dp"
                            app:chipStrokeWidth="0dp"
                            android:textColor="@color/chip_selector_text"
                            app:textEndPadding="16dp"
                            app:textStartPadding="16dp" />

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipDrafts"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/diet_plans_tab_drafts"
                            app:checkedIconVisible="false"
                            android:checkable="true"
                            app:chipBackgroundColor="@color/chip_selector_bg"
                            app:chipCornerRadius="18dp"
                            app:chipStrokeWidth="0dp"
                            android:textColor="@color/chip_selector_text"
                            app:textEndPadding="16dp"
                            app:textStartPadding="16dp" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- KENDİ LİSTENİ OLUŞTUR - DİĞERLERİNDEN FARKLI -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/createOwnPlanCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/fitto_primary_soft"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fitto_primary_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="18dp">

                    <com.google.android.material.card.MaterialCardView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            app:cardBackgroundColor="@color/fitto_background_light"
                            app:cardCornerRadius="30dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/fitto_primary_soft"
                            app:strokeWidth="1dp">

                        <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/diet_plans_create_title"
                                android:src="@drawable/ic_add"
                                app:tint="@color/fitto_green" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/diet_plans_create_title"
                                android:textColor="@color/fitto_green"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/diet_plans_create_subtitle"
                                android:textColor="@color/fitto_text_secondary"
                                android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            app:cardBackgroundColor="@color/fitto_background_light"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp">

                        <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/diet_plans_create_title"
                                android:rotation="-90"
                                android:src="@drawable/ic_keyboard_arrow_down"
                                app:tint="@color/fitto_green" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <!-- SANA ÖZEL ÖNERİ -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/personalizedRecommendationCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/fitto_background_light"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/fitto_green"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_fitto_chip"
                                android:gravity="center"
                                android:text="✨"
                                android:textSize="22sp" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                            <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/diet_plans_personalized_title"
                                    android:textColor="@color/fitto_green"
                                    android:textSize="20sp"
                                    android:textStyle="bold" />

                            <TextView
                                    android:id="@+id/personalizedSubtitleText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="@string/diet_plans_personalized_subtitle"
                                    android:textColor="@color/fitto_text_secondary"
                                    android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                                android:id="@+id/personalizedMatchText"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_fitto_chip"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:text="@string/diet_plans_personalized_match_mock"
                                android:textColor="@color/fitto_green"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                            android:id="@+id/personalizedPlanTitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="@string/diet_plan_mediterranean_title"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/personalizedPlanDescText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/diet_plans_personalized_reason_mediterranean"
                            android:textColor="@color/fitto_text_secondary"
                            android:textSize="14sp" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                        <TextView
                                android:id="@+id/personalizedReasonChip1"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_fitto_chip"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/diet_plans_personalized_chip_balanced"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/personalizedReasonChip2"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_fitto_chip"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/diet_plans_personalized_chip_sustainable"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/personalizedReasonChip3"
                                android:layout_width="0dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_fitto_chip"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/diet_plans_personalized_chip_easy_start"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/personalizedDetailButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="@string/diet_plans_personalized_detail"
                                android:textAllCaps="false"
                                android:textColor="@color/fitto_green"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:cornerRadius="16dp"
                                app:icon="@null"
                                app:strokeColor="@color/fitto_green"
                                app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/personalizedApplyButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="@string/diet_plans_personalized_apply"
                                android:textAllCaps="false"
                                android:textColor="@android:color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:backgroundTint="@color/fitto_green"
                                app:cornerRadius="16dp"
                                app:icon="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                    android:id="@+id/dietPlansEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:padding="18dp"
                    android:text="@string/diet_plans_empty_drafts"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            <!-- LİSTE -->
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/dietPlansRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>