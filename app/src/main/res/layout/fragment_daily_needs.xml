<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/dailyNeedsRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

    <include
            android:id="@+id/onboardingProgressContainer"
            layout="@layout/view_onboarding_progress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
            android:id="@+id/dailyNeedsBackButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_fitto_circle_soft"
            android:contentDescription="@string/back"
            android:padding="18dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/fitto_green"
            app:layout_constraintTop_toBottomOf="@id/onboardingProgressContainer"
            app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
            android:id="@+id/dailyNeedsScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="92dp"
            app:layout_constraintTop_toBottomOf="@id/dailyNeedsBackButton"
            app:layout_constraintBottom_toTopOf="@id/dailyNeedsNextButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:id="@+id/dailyNeedsContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <LinearLayout
                    android:id="@+id/dailyNeedsHeaderCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_fitto_card_large"
                    android:elevation="3dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="24dp">

                <TextView
                        android:id="@+id/dailyNeedsTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/daily_needs_title"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="31sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/dailyNeedsDescriptionText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/daily_needs_description"
                        android:textColor="#666A6D"
                        android:textSize="17sp" />

                <TextView
                        android:id="@+id/dailyNeedsNoteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/daily_needs_note"
                        android:textColor="#8A8F92"
                        android:textSize="14sp" />

            </LinearLayout>

            <GridLayout
                    android:id="@+id/dailyNeedsFeatureGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:useDefaultMargins="false">

                <LinearLayout
                        android:id="@+id/hydrationFeatureCard"
                        android:layout_width="0dp"
                        android:layout_height="185dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_fitto_card"
                        android:elevation="2dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp">

                    <ImageView
                            android:layout_width="66dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_hydration"
                            android:scaleType="fitCenter" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="@string/daily_needs_hydration_title"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="158dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/daily_needs_hydration_desc"
                            android:textColor="#666A6D"
                            android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                        android:id="@+id/stepsFeatureCard"
                        android:layout_width="0dp"
                        android:layout_height="185dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="7dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_fitto_card"
                        android:elevation="2dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp">

                    <ImageView
                            android:layout_width="110dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_steps_count"
                            android:scaleType="fitCenter" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="@string/daily_needs_steps_title"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/daily_needs_steps_desc"
                            android:textColor="#666A6D"
                            android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                        android:id="@+id/calorieFeatureCard"
                        android:layout_width="0dp"
                        android:layout_height="185dp"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_fitto_card"
                        android:elevation="2dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp">

                    <ImageView
                            android:layout_width="66dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_calorie_progress"
                            android:scaleType="fitCenter" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="@string/daily_needs_calorie_title"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/daily_needs_calorie_desc"
                            android:textColor="#666A6D"
                            android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                        android:id="@+id/activeTimeFeatureCard"
                        android:layout_width="0dp"
                        android:layout_height="185dp"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_fitto_card"
                        android:elevation="2dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp">

                    <ImageView
                            android:layout_width="66dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_active_time"
                            android:scaleType="fitCenter" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:text="@string/daily_needs_active_time_title"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/daily_needs_active_time_desc"
                            android:textColor="#666A6D"
                            android:textSize="13sp" />

                </LinearLayout>

            </GridLayout>

        </LinearLayout>

    </ScrollView>

    <TextView
            android:id="@+id/dailyNeedsNextButton"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_fitto_button_primary"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/daily_needs_button"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>