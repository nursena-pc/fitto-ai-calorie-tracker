<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fitto_bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

    <!-- Sürükleme Tutamacı (Handle) -->
    <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_fitto_bottom_sheet_handle" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/daily_quick_add_title"
            android:textColor="@color/fitto_text_dark"
            android:textSize="21sp"
            android:textStyle="bold" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/daily_quick_add_subtitle"
            android:textColor="@color/fitto_text_secondary"
            android:textSize="14sp" />

    <!-- Yemek Ara -->
    <LinearLayout
            android:id="@+id/quickAddSearchFood"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="18dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_fitto_circle_soft"
                android:padding="10dp"
                android:src="@drawable/ic_search"
                app:tint="@color/fitto_green" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_quick_add_search_food"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/daily_quick_add_search_food_desc"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp" />
        </LinearLayout>

        <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

    <!-- Kamera ile Ekle -->
    <LinearLayout
            android:id="@+id/quickAddCameraFood"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_fitto_circle_soft"
                android:padding="10dp"
                android:src="@drawable/ic_camera"
                app:tint="@color/fitto_green" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_quick_add_camera_food"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/cameraDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/daily_quick_add_camera_food_desc"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp" />
        </LinearLayout>

        <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

    <!-- Yemek Oluştur -->
    <LinearLayout
            android:id="@+id/quickAddCreateFood"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_fitto_circle_soft"
                android:padding="10dp"
                android:src="@drawable/ic_chef_hat"
                app:tint="@color/fitto_green" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_quick_add_create_food"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/daily_quick_add_create_food_desc"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp" />
        </LinearLayout>

        <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

    <!-- Su Takibi -->
    <LinearLayout
            android:id="@+id/quickAddWater"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_fitto_circle_soft"
                android:padding="8dp"
                android:src="@drawable/ic_hydration" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_quick_add_water"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/daily_quick_add_water_desc"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp" />
        </LinearLayout>

        <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

    <!-- Aktivite Ekle -->
    <LinearLayout
            android:id="@+id/quickAddActivity"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_fitto_circle_soft"
                android:padding="10dp"
                android:src="@drawable/ic_fitness"
                app:tint="@color/fitto_green" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_quick_add_activity"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/daily_quick_add_activity_desc"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp" />
        </LinearLayout>

        <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

    <!-- Diyet Planı -->
    <LinearLayout
            android:id="@+id/quickAddDietPlan"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_fitto_circle_soft"
                android:padding="10dp"
                android:src="@drawable/ic_nav_daily"
                app:tint="@color/fitto_green" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_quick_add_diet_plan"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/daily_quick_add_diet_plan_desc"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp" />
        </LinearLayout>

        <ImageView
                android:id="@+id/imgChevron"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

</LinearLayout>