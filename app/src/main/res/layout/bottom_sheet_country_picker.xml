<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/countryPickerRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fitto_bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

    <View
            android:layout_width="42dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_fitto_bottom_sheet_handle" />

    <LinearLayout
            android:id="@+id/countryPickerHeader"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/countryPickerTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/country_picker_title"
                android:textColor="@color/fitto_text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/countryPickerDoneText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/done"
                android:textColor="@color/fitto_green"
                android:textSize="18sp"
                android:textStyle="bold" />

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/countrySearchInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/country_picker_search"
            app:boxBackgroundColor="@color/fitto_surface"
            app:boxCornerRadiusBottomEnd="18dp"
            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"
            app:boxCornerRadiusTopStart="18dp"
            app:boxStrokeColor="#D8DAD6"
            app:hintTextColor="#777777"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/fitto_green">

        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/countrySearchEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/fitto_text_dark"
                android:textSize="18sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/countryRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

</LinearLayout>