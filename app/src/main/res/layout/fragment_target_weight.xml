<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/targetWeightRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

    <ImageButton
            android:id="@+id/targetWeightBackButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_fitto_circle_soft"
            android:contentDescription="@string/back"
            android:padding="16dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/fitto_text_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <include
            android:id="@+id/onboardingProgressContainer"
            layout="@layout/view_onboarding_progress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/targetWeightBackButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
            android:id="@+id/targetWeightScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="26dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="92dp"
            app:layout_constraintTop_toBottomOf="@id/onboardingProgressContainer"
            app:layout_constraintBottom_toTopOf="@id/targetWeightNextButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:id="@+id/targetWeightContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/targetWeightTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/target_weight_title"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="34sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/targetWeightDescriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/target_weight_description"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="18sp" />

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/targetWeightInputCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    app:cardBackgroundColor="@color/fitto_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/fitto_divider_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/target_weight_label"
                            android:textColor="@color/fitto_green"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/targetWeightInputLayout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:boxBackgroundColor="@color/fitto_surface"
                            app:boxCornerRadiusBottomEnd="16dp"
                            app:boxCornerRadiusBottomStart="16dp"
                            app:boxCornerRadiusTopEnd="16dp"
                            app:boxCornerRadiusTopStart="16dp"
                            app:boxStrokeColor="@color/fitto_green"
                            app:endIconDrawable="@drawable/ic_check_circle"
                            app:endIconMode="custom"
                            app:endIconTint="@color/fitto_green"
                            app:errorEnabled="true"
                            app:hintEnabled="false"
                            app:suffixText="kg"
                            app:suffixTextColor="@color/fitto_text_secondary">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/targetWeightEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="number"
                                android:maxLength="3"
                                android:singleLine="true"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="34sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/target_weight_input_card_helper"
                            android:textColor="@color/fitto_text_secondary"
                            android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/targetWeightLiveFeedbackCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/fitto_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fitto_primary_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="14dp">

                    <ImageView
                            android:id="@+id/targetWeightLiveFeedbackIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginTop="1dp"
                            android:contentDescription="@string/target_weight_live_feedback_title"
                            android:src="@drawable/ic_info"
                            app:tint="@color/fitto_green" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/targetWeightLiveFeedbackTitleText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/targetWeightLiveFeedbackText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="3dp"
                                android:textColor="@color/fitto_text_secondary"
                                android:textSize="14sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/targetWeightLocalFeedbackProgressIndicator"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:indicatorColor="@color/fitto_green"
                                app:trackColor="@color/fitto_primary_soft"
                                app:trackThickness="3dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                    android:id="@+id/targetWeightInfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_fitto_chip"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/target_weight_info"
                        android:src="@drawable/ic_info"
                        app:tint="@color/fitto_green" />

                <TextView
                        android:id="@+id/targetWeightInfoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/target_weight_info_full"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="14sp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/targetWeightAiCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/target_weight_ai_card_background"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/target_weight_ai_card_stroke"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal">

                        <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_fitto_circle_soft"
                                android:contentDescription="@string/target_weight_ai_title"
                                android:padding="10dp"
                                android:src="@drawable/ic_auto_awesome"
                                app:tint="@color/fitto_green" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                            <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                <TextView
                                        android:id="@+id/targetWeightAiTitleText"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/target_weight_ai_title"
                                        android:textColor="@color/fitto_green"
                                        android:textSize="17sp"
                                        android:textStyle="bold" />

                                <TextView
                                        android:id="@+id/targetWeightAiBadgeText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/bg_fitto_pill_soft_green"
                                        android:paddingStart="12dp"
                                        android:paddingTop="6dp"
                                        android:paddingEnd="12dp"
                                        android:paddingBottom="6dp"
                                        android:text="@string/target_weight_ai_badge"
                                        android:textColor="@color/fitto_green"
                                        android:textSize="13sp"
                                        android:textStyle="bold" />

                            </LinearLayout>

                            <TextView
                                    android:id="@+id/targetWeightAiDescriptionText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:lineSpacingExtra="3dp"
                                    android:text="@string/target_weight_ai_description"
                                    android:textColor="@color/fitto_text_secondary"
                                    android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/targetWeightAiProgressIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/fitto_green"
                            app:indicatorSize="32dp"
                            app:trackThickness="4dp" />

                    <TextView
                            android:id="@+id/targetWeightAiStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/target_weight_ai_auto_loading"
                            android:textColor="@color/fitto_text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    <TextView
                            android:id="@+id/targetWeightAiErrorText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/target_weight_ai_error"
                            android:textColor="@color/fitto_error"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/targetWeightAiRetryButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:text="@string/target_weight_ai_retry_button"
                            android:textAllCaps="false"
                            android:textColor="@color/fitto_green"
                            android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                            android:id="@+id/targetWeightAiResultCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/fitto_surface"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/fitto_primary_extra_soft"
                            app:strokeWidth="1dp">

                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="14dp">

                            <ImageView
                                    android:layout_width="44dp"
                                    android:layout_height="44dp"
                                    android:background="@drawable/bg_fitto_circle_soft"
                                    android:contentDescription="@string/target_weight_ai_result_title"
                                    android:padding="11dp"
                                    android:src="@drawable/ic_monitor_weight"
                                    app:tint="@color/fitto_green" />

                            <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:gravity="center_vertical"
                                        android:orientation="horizontal">

                                    <TextView
                                            android:id="@+id/targetWeightAiResultTitleText"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="@string/target_weight_ai_recommended_target_label"
                                            android:textColor="@color/fitto_text_dark"
                                            android:textSize="16sp"
                                            android:textStyle="bold" />

                                    <TextView
                                            android:id="@+id/targetWeightAiResultWeightText"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="6dp"
                                            android:textColor="@color/fitto_green"
                                            android:textSize="18sp"
                                            android:textStyle="bold" />

                                </LinearLayout>

                                <TextView
                                        android:id="@+id/targetWeightAiResultExplanationText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="8dp"
                                        android:lineSpacingExtra="3dp"
                                        android:textColor="@color/fitto_text_secondary"
                                        android:textSize="14sp" />

                                <TextView
                                        android:id="@+id/targetWeightAiResultWarningText"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:visibility="gone" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/targetWeightUseAiButton"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:maxLines="1"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:singleLine="true"
                                android:text="@string/target_weight_ai_use_button"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:backgroundTint="@color/fitto_green"
                                app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                                android:id="@+id/targetWeightAiReasonButton"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:maxLines="2"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:paddingStart="6dp"
                                android:paddingEnd="6dp"
                                android:text="@string/target_weight_ai_why_button"
                                android:textAllCaps="false"
                                android:textColor="@color/fitto_green"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:cornerRadius="16dp"
                                app:strokeColor="@color/fitto_green" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/targetWeightGuidanceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/fitto_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fitto_divider_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:contentDescription="@string/target_weight_approach_title"
                                android:src="@drawable/ic_bullseye_arrow"
                                app:tint="@color/fitto_green" />

                        <TextView
                                android:id="@+id/targetWeightGuidanceTitleText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/target_weight_approach_title"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_target_weight_segment_container"
                            android:orientation="horizontal"
                            android:padding="2dp">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/target_weight_approach_relaxed"
                                android:textColor="@color/fitto_text_secondary"
                                android:textSize="15sp" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_target_weight_segment_selected"
                                android:gravity="center"
                                android:text="@string/target_weight_approach_balanced"
                                android:textColor="@color/fitto_green"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/target_weight_approach_fast"
                                android:textColor="@color/fitto_text_secondary"
                                android:textSize="15sp" />

                    </LinearLayout>

                    <TextView
                            android:id="@+id/targetWeightGuidanceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/target_weight_approach_balanced_description"
                            android:textColor="@color/fitto_text_secondary"
                            android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/target_weight_success_card_background"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fitto_primary_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="16dp">

                    <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="@string/target_weight_guidance_title"
                            android:src="@drawable/ic_check_circle"
                            app:tint="@color/fitto_green" />

                    <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/target_weight_success_guidance"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="16sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/targetWeightNextButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginBottom="18dp"
            android:elevation="4dp"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fitto_green"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
