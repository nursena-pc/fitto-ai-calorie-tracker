<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/targetWeightRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

    <include
            android:id="@+id/onboardingProgressContainer"
            layout="@layout/view_onboarding_progress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
            android:id="@+id/targetWeightBackButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_fitto_circle_soft"
            android:contentDescription="@string/back"
            android:padding="18dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/fitto_green"
            app:layout_constraintTop_toBottomOf="@id/onboardingProgressContainer"
            app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
            android:id="@+id/targetWeightScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="92dp"
            app:layout_constraintTop_toBottomOf="@id/targetWeightBackButton"
            app:layout_constraintBottom_toTopOf="@id/targetWeightNextButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:id="@+id/targetWeightContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/targetWeightTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/target_weight_title"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/targetWeightDescriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/target_weight_description"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="18sp" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/targetWeightInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:hint="@string/target_weight_label"
                    app:boxBackgroundColor="@color/fitto_surface"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxStrokeColor="@color/fitto_green"
                    app:errorEnabled="true"
                    app:hintTextColor="@color/fitto_green"
                    app:suffixText="kg"
                    app:suffixTextColor="@color/fitto_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/targetWeightEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:maxLength="3"
                        android:singleLine="true"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/targetWeightLiveFeedbackCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/fitto_surface"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fitto_primary_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="14dp">

                    <ImageView
                            android:id="@+id/targetWeightLiveFeedbackIcon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginTop="1dp"
                            android:contentDescription="@string/target_weight_live_feedback_title"
                            android:src="@drawable/ic_info"
                            app:tint="@color/fitto_green" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/targetWeightLiveFeedbackTitleText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/targetWeightLiveFeedbackText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:lineSpacingExtra="3dp"
                                android:textColor="@color/fitto_text_secondary"
                                android:textSize="14sp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/targetWeightLocalFeedbackProgressIndicator"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:indeterminate="true"
                                android:visibility="gone"
                                app:indicatorColor="@color/fitto_green"
                                app:trackColor="@color/fitto_primary_soft"
                                app:trackThickness="3dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                    android:id="@+id/targetWeightInfoCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_fitto_chip"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:visibility="gone">

                <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/target_weight_info"
                        android:src="@drawable/ic_info"
                        app:tint="@color/fitto_green" />

                <TextView
                        android:id="@+id/targetWeightInfoText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/target_weight_info_full"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="14sp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/targetWeightAiCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    app:cardBackgroundColor="@color/fitto_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fitto_primary_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <TextView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_fitto_circle_soft"
                                android:gravity="center"
                                android:text="✨"
                                android:textSize="22sp" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                            <TextView
                                    android:id="@+id/targetWeightAiTitleText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/target_weight_ai_title"
                                    android:textColor="@color/fitto_text_dark"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                            <TextView
                                    android:id="@+id/targetWeightAiDescriptionText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:lineSpacingExtra="3dp"
                                    android:text="@string/target_weight_ai_description"
                                    android:textColor="@color/fitto_text_secondary"
                                    android:textSize="14sp" />

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/targetWeightAiProgressIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="16dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorColor="@color/fitto_green"
                            app:indicatorSize="32dp"
                            app:trackThickness="4dp" />

                    <TextView
                            android:id="@+id/targetWeightAiStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:text="@string/target_weight_ai_auto_loading"
                            android:textColor="@color/fitto_text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    <TextView
                            android:id="@+id/targetWeightAiErrorText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/target_weight_ai_error"
                            android:textColor="@color/fitto_error"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/targetWeightAiRetryButton"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:text="@string/target_weight_ai_retry_button"
                            android:textAllCaps="false"
                            android:textColor="@color/fitto_green"
                            android:visibility="gone" />

                    <com.google.android.material.card.MaterialCardView
                            android:id="@+id/targetWeightAiResultCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:visibility="gone"
                            app:cardBackgroundColor="@color/fitto_surface"
                            app:cardCornerRadius="18dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/fitto_primary_soft"
                            app:strokeWidth="1dp">

                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="16dp">

                            <TextView
                                    android:id="@+id/targetWeightAiResultTitleText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/fitto_text_dark"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                            <TextView
                                    android:id="@+id/targetWeightAiResultWeightText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:textColor="@color/fitto_green"
                                    android:textSize="30sp"
                                    android:textStyle="bold" />

                            <TextView
                                    android:id="@+id/targetWeightAiResultExplanationText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:lineSpacingExtra="3dp"
                                    android:textColor="@color/fitto_text_secondary"
                                    android:textSize="14sp" />

                            <TextView
                                    android:id="@+id/targetWeightAiResultWarningText"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:lineSpacingExtra="3dp"
                                    android:textColor="@color/fitto_text_secondary"
                                    android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                    android:id="@+id/targetWeightUseAiButton"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="match_parent"
                                    android:layout_height="52dp"
                                    android:layout_marginTop="14dp"
                                    android:text="@string/target_weight_ai_use_button"
                                    android:textAllCaps="false"
                                    android:textColor="@color/fitto_green"
                                    app:cornerRadius="24dp"
                                    app:strokeColor="@color/fitto_green" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                    android:id="@+id/targetWeightGuidanceCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_fitto_card_normal"
                    android:orientation="vertical"
                    android:padding="18dp">

                <TextView
                        android:id="@+id/targetWeightGuidanceTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/target_weight_guidance_title"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/targetWeightGuidanceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/target_weight_guidance"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="15sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/targetWeightNextButton"
            style="@style/Widget.Material3.Button"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginBottom="20dp"
            android:elevation="4dp"
            android:text="@string/next"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fitto_green"
            app:cornerRadius="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
