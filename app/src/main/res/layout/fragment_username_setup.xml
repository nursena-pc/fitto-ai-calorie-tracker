<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/usernameSetupRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/profile_screen_background"
        android:clipChildren="false"
        android:clipToPadding="false">

    <include
            android:id="@+id/authBottomDecoration"
            layout="@layout/include_auth_bottom_decor"
            android:layout_width="0dp"
            android:layout_height="125dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <androidx.core.widget.NestedScrollView
            android:id="@+id/usernameSetupScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="24dp"
            android:paddingTop="48dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            app:layout_constraintBottom_toTopOf="@id/usernameContinueButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
                android:id="@+id/usernameContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/usernameHeroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#F1EBC1"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="22dp">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                        <TextView
                                android:id="@+id/usernameWelcomeText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/fitto_green"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/usernameTitleText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/username_setup_title"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="24sp"
                                android:textStyle="bold" />

                        <TextView
                                android:id="@+id/usernameDescText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:lineSpacingExtra="5dp"
                                android:text="@string/username_setup_desc"
                                android:textColor="#5F6467"
                                android:textSize="14sp" />

                    </LinearLayout>

                    <ImageView
                            android:id="@+id/usernameMascotImage"
                            android:layout_width="112dp"
                            android:layout_height="112dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="8dp"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/app_name"
                            android:scaleType="fitCenter"
                            android:src="@drawable/fitto_mascot" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/usernameInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:hint="@string/username_setup_label"
                    app:boxBackgroundColor="@color/profile_screen_background"
                    app:boxCornerRadiusBottomEnd="22dp"
                    app:boxCornerRadiusBottomStart="22dp"
                    app:boxCornerRadiusTopEnd="22dp"
                    app:boxCornerRadiusTopStart="22dp"
                    app:boxStrokeColor="@color/fitto_green"
                    app:boxStrokeWidth="2dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:errorEnabled="true"
                    app:helperText="@string/username_setup_helper"
                    app:helperTextTextColor="#666A6D"
                    app:hintTextColor="@color/fitto_green"
                    app:prefixText="@"
                    app:prefixTextColor="@color/fitto_green"
                    app:startIconDrawable="@drawable/ic_person_outline"
                    app:startIconTint="@color/fitto_green">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/usernameEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="text"
                        android:maxLength="20"
                        android:singleLine="true"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                    android:id="@+id/usernameStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/fitto_green"
                    android:textSize="14sp"
                    android:visibility="gone" />

            <LinearLayout
                    android:id="@+id/usernameSuggestionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/usernameSuggestionOne"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:minWidth="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textAllCaps="false"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="#F1EBC1"
                            app:cornerRadius="11dp"
                            app:strokeColor="#7D7A73"
                            app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/usernameSuggestionTwo"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="10dp"
                            android:minWidth="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textAllCaps="false"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="#F1EBC1"
                            app:cornerRadius="11dp"
                            app:strokeColor="#7D7A73"
                            app:strokeWidth="1dp" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/usernameSuggestionThree"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textAllCaps="false"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="#F1EBC1"
                        app:cornerRadius="11dp"
                        app:strokeColor="#7D7A73"
                        app:strokeWidth="1dp" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/usernameTipCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="34dp"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/fitto_surface"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="24dp">

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/username_setup_tip_title"
                            android:textColor="@color/fitto_green"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:lineSpacingExtra="4dp"
                            android:text="@string/username_setup_tip_desc"
                            android:textColor="#5F6467"
                            android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/usernameContinueButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:enabled="false"
            android:elevation="8dp"
            android:text="@string/username_setup_continue"
            android:textAllCaps="false"
            android:textColor="#9FA09A"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#D6D8CD"
            app:cornerRadius="22dp"
            app:elevation="8dp"
            app:layout_constraintBottom_toTopOf="@id/authBottomDecoration"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>