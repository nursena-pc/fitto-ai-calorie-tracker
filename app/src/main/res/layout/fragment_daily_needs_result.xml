<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/dailyNeedsResultRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

    <include
            android:id="@+id/onboardingProgressContainer"
            layout="@layout/view_onboarding_progress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
            android:id="@+id/resultScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:clipToPadding="false"
            android:fillViewport="false"
            android:overScrollMode="never"
            android:paddingBottom="160dp"
            app:layout_constraintTop_toBottomOf="@id/onboardingProgressContainer"
            app:layout_constraintBottom_toTopOf="@id/resultStartPlanButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:id="@+id/resultContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/resultTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/result_title"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/resultAiBadgeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/result_ai_badge_loading_bg"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/result_ai_badge_loading_stroke"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                    <TextView
                            android:id="@+id/resultAiBadgeText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/result_ai_badge_loading"
                            android:textColor="@color/result_ai_badge_loading_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/resultAiBadgeDescriptionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/result_ai_badge_loading_desc"
                            android:textColor="@color/result_ai_badge_loading_text"
                            android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                    android:id="@+id/resultGaugeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_fitto_card_large"
                    android:elevation="4dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="20dp">

                <TextView
                        android:id="@+id/resultDailyPlanText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/result_daily_plan"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                <com.example.fitto.feature_auth.register.CalorieGaugeView
                        android:id="@+id/calorieGaugeView"
                        android:layout_width="match_parent"
                        android:layout_height="210dp"
                        android:layout_marginTop="12dp" />

                <TextView
                        android:id="@+id/resultTargetDailyCalorieLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/result_target_daily_calorie"
                        android:textColor="#777D81"
                        android:textSize="15sp" />

                <TextView
                        android:id="@+id/resultStatusTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:textColor="@color/fitto_green"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                <LinearLayout
                        android:id="@+id/resultScaleContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="7dp"
                                android:background="@drawable/bg_result_scale_green" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/result_balanced"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/result_healthy"
                                android:textColor="#777D81"
                                android:textSize="11sp" />
                    </LinearLayout>

                    <Space
                            android:layout_width="6dp"
                            android:layout_height="wrap_content" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="7dp"
                                android:background="@drawable/bg_result_scale_yellow" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/result_fast"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/result_be_careful"
                                android:textColor="#777D81"
                                android:textSize="11sp" />
                    </LinearLayout>

                    <Space
                            android:layout_width="6dp"
                            android:layout_height="wrap_content" />

                    <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                        <View
                                android:layout_width="match_parent"
                                android:layout_height="7dp"
                                android:background="@drawable/bg_result_scale_red" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/result_risky"
                                android:textColor="@color/fitto_text_dark"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/result_not_recommended_short"
                                android:textColor="#777D81"
                                android:textSize="11sp" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                    android:id="@+id/resultSummaryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical">

                <include
                        android:id="@+id/summaryDailyNeedsRow"
                        layout="@layout/item_result_summary_row" />

                <include
                        android:id="@+id/summaryTargetCalorieRow"
                        layout="@layout/item_result_summary_row" />

                <include
                        android:id="@+id/summaryRecommendedCalorieRow"
                        layout="@layout/item_result_summary_row" />

                <include
                        android:id="@+id/summaryWeeklyChangeRow"
                        layout="@layout/item_result_summary_row" />

                <include
                        android:id="@+id/summaryEstimatedTimeRow"
                        layout="@layout/item_result_summary_row" />

            </LinearLayout>

            <TextView
                    android:id="@+id/resultStatusCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="36dp"
                    android:background="@drawable/bg_result_status_healthy"
                    android:breakStrategy="high_quality"
                    android:gravity="start|center_vertical"
                    android:hyphenationFrequency="none"
                    android:includeFontPadding="true"
                    android:lineSpacingExtra="6dp"
                    android:paddingStart="24dp"
                    android:paddingTop="22dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="28dp"
                    android:scrollHorizontally="false"
                    android:singleLine="false"
                    android:textColor="#555B5E"
                    android:textSize="17sp" />

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/resultAiCommentCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-18dp"
                    android:layout_marginBottom="36dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/fitto_surface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/fitto_primary_soft"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                    <TextView
                            android:id="@+id/resultAiCommentTitleText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/result_ai_comment_title"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/resultAiCommentBodyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:lineSpacingExtra="5dp"
                            android:textColor="@color/fitto_text_secondary"
                            android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <TextView
            android:id="@+id/resultStartPlanButton"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_fitto_button_primary"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/result_start_my_plan"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>