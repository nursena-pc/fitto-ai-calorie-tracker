<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fitto_bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

    <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_fitto_bottom_sheet_handle" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/foodEmojiText"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_add_meal_food_thumbnail"
                android:gravity="center"
                android:textSize="31sp"
                tools:text="🥣" />

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/foodNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Tavuk Göğsü" />

            <TextView
                    android:id="@+id/foodServingText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp"
                    tools:text="Varsayılan porsiyon: 40 g" />
        </LinearLayout>

        <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_cancel"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/fitto_surface_soft"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/fitto_divider_soft"
            app:strokeWidth="1dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/portion_sheet_amount_title"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/amountHintText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="12sp"
                        tools:text="100 g baz değer: 375 kcal" />
            </LinearLayout>

            <ImageButton
                    android:id="@+id/decreaseAmountButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_add_meal_remove_circle"
                    android:contentDescription="@string/portion_sheet_decrease"
                    android:padding="11dp"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/white" />

            <LinearLayout
                    android:layout_width="82dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                <EditText
                        android:id="@+id/portionAmountEditText"
                        android:layout_width="96dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="@drawable/bg_fitto_chip"
                        android:gravity="center"
                        android:hint="100"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLines="1"
                        android:paddingHorizontal="8dp"
                        android:selectAllOnFocus="true"
                        android:textColor="@color/fitto_text_dark"
                        android:textColorHint="@color/fitto_text_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/amountUnitText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="13sp"
                        tools:text="g" />
            </LinearLayout>

            <ImageButton
                    android:id="@+id/increaseAmountButton"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_add_meal_plus_circle"
                    android:contentDescription="@string/portion_sheet_increase"
                    android:padding="11dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fitto_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fitto_divider_soft"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/portion_sheet_calories"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/caloriesValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/fitto_green"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="150 kcal" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fitto_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fitto_divider_soft"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/portion_sheet_protein"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/proteinValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="5.2 g" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fitto_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fitto_divider_soft"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/portion_sheet_carbs"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/carbsValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="26.8 g" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/fitto_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/fitto_divider_soft"
                app:strokeWidth="1dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/portion_sheet_fat"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="12sp" />

                <TextView
                        android:id="@+id/fatValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="2.8 g" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/addPortionButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/fitto_green"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            tools:text="Seçime ekle · 150 kcal" />
</LinearLayout>
