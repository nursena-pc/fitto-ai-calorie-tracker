<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fitto_bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

    <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_fitto_bottom_sheet_handle" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/fitto_text_dark"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Yulaf ezmesi" />

        <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_cancel"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/fitto_surface_soft"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/fitto_divider_soft"
            app:strokeWidth="1dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="18dp">

            <ImageButton
                    android:id="@+id/decreaseButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_add_meal_remove_circle"
                    android:contentDescription="@string/portion_sheet_decrease"
                    android:padding="12dp"
                    android:src="@drawable/ic_remove"
                    app:tint="@color/white" />

            <EditText
                    android:id="@+id/amountEditText"
                    android:layout_width="110dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_fitto_chip"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="60" />

            <TextView
                    android:id="@+id/unitText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="g" />

            <ImageButton
                    android:id="@+id/increaseButton"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_add_meal_plus_circle"
                    android:contentDescription="@string/portion_sheet_increase"
                    android:padding="12dp"
                    android:src="@drawable/ic_add"
                    app:tint="@color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="@color/fitto_green"
            android:text="@string/meal_entry_food_amount_save"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />
</LinearLayout>