<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fitto_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exercise_filter_title"
            android:textColor="@color/fitto_text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/exercise_filter_subtitle"
            android:textColor="@color/fitto_text_secondary"
            android:textSize="13sp" />

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/exercise_filter_duration_title"
            android:textColor="@color/fitto_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
            android:id="@+id/durationChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

        <com.google.android.material.chip.Chip
                android:id="@+id/durationAllChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_filter_all" />

        <com.google.android.material.chip.Chip
                android:id="@+id/durationShortChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_filter_duration_short_desc" />

        <com.google.android.material.chip.Chip
                android:id="@+id/durationMediumChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_filter_duration_medium_desc" />

        <com.google.android.material.chip.Chip
                android:id="@+id/durationLongChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_filter_duration_long_desc" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/exercise_filter_intensity_title"
            android:textColor="@color/fitto_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
            android:id="@+id/intensityChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

        <com.google.android.material.chip.Chip
                android:id="@+id/intensityAllChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_filter_all" />

        <com.google.android.material.chip.Chip
                android:id="@+id/intensityLightChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_intensity_light" />

        <com.google.android.material.chip.Chip
                android:id="@+id/intensityModerateChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_intensity_moderate" />

        <com.google.android.material.chip.Chip
                android:id="@+id/intensityVigorousChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_intensity_vigorous" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/exercise_filter_sort_title"
            android:textColor="@color/fitto_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

    <com.google.android.material.chip.ChipGroup
            android:id="@+id/sortChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

        <com.google.android.material.chip.Chip
                android:id="@+id/sortRecommendedChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_sort_recommended" />

        <com.google.android.material.chip.Chip
                android:id="@+id/sortKcalLowHighChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_sort_kcal_low_high" />

        <com.google.android.material.chip.Chip
                android:id="@+id/sortKcalHighLowChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_sort_kcal_high_low" />

        <com.google.android.material.chip.Chip
                android:id="@+id/sortDurationLowHighChip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exercise_sort_duration_low_high" />
    </com.google.android.material.chip.ChipGroup>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/resetFilterButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/exercise_filter_reset"
                android:textAllCaps="false"
                android:textColor="@color/fitto_green"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="@color/fitto_green" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/applyFilterButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.4"
                android:backgroundTint="@color/fitto_green"
                android:text="@string/exercise_filter_apply"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>