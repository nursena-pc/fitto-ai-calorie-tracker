<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/commentRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

    <LinearLayout
            android:id="@+id/commentRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

        <FrameLayout
                android:id="@+id/commentAvatarContainer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_circle_primary_soft">

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/commentAvatarImage"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Fitto.Circle" />

            <TextView
                    android:id="@+id/commentAvatarInitialText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/fitto_green"
                    android:textSize="14sp"
                    android:textStyle="bold" />

        </FrameLayout>

        <LinearLayout
                android:id="@+id/commentContentContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

            <LinearLayout
                    android:id="@+id/commentBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_comment_bubble"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                    <TextView
                            android:id="@+id/commentUserNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/fitto_text_dark"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/commentTimeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/fitto_text_secondary"
                            android:textSize="11sp" />

                </LinearLayout>

                <TextView
                        android:id="@+id/commentBodyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="14sp" />

            </LinearLayout>

            <LinearLayout
                    android:id="@+id/commentActionRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <TextView
                        android:id="@+id/replyCommentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/social_reply_comment"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/toggleRepliesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:textColor="@color/fitto_green"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
                android:id="@+id/commentLikeContainer"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

            <ImageButton
                    android:id="@+id/commentLikeButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/social_like_comment"
                    android:padding="7dp"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="@color/fitto_text_secondary" />

            <TextView
                    android:id="@+id/commentLikeCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="11sp"
                    android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>