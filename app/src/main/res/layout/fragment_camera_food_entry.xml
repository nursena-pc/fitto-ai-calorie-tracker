<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_text_dark">

    <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreviewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <ImageView
            android:id="@+id/capturedImageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />

    <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="42dp"
            android:background="@drawable/bg_add_meal_food_thumbnail"
            android:contentDescription="@string/common_cancel"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="@color/fitto_text_dark" />

    <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_fitto_bottom_sheet"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

        <TextView
                android:id="@+id/titleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/camera_food_title"
                android:textColor="@color/fitto_text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/camera_food_subtitle"
                android:textColor="@color/fitto_text_secondary"
                android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/captureButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/fitto_green"
                android:text="@string/camera_food_capture"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="18dp" />

        <LinearLayout
                android:id="@+id/afterCaptureActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/retakeButton"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/camera_food_retake"
                    android:textAllCaps="false"
                    android:textColor="@color/fitto_green"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/fitto_green" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/usePhotoButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/fitto_green"
                    android:text="@string/camera_food_use_photo"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    app:cornerRadius="16dp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>