<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fitto_surface"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

    <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_action_panel" />

    <TextView
            android:id="@+id/loginOptionsTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_options_title"
            android:textColor="@color/fitto_text_dark"
            android:textSize="24sp"
            android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/loginOptionsEmailButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="@string/login_options_email"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fitto_green"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_email"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

    <LinearLayout
            android:id="@+id/loginOptionsDividerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

        <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/fitto_divider_soft" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:text="@string/login_or"
                android:textColor="@color/fitto_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold" />

        <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/fitto_divider_soft" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/loginOptionsGoogleButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:text="@string/login_options_google"
            android:textAllCaps="false"
            android:textColor="@color/fitto_green"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_google_g"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/fitto_green"
            app:strokeColor="@color/fitto_green"
            app:strokeWidth="1dp" />

    <TextView
            android:id="@+id/loginOptionsRegisterText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/login_not_member_cta"
            android:textColor="@color/fitto_text_dark"
            android:textSize="15sp"
            android:textStyle="bold" />

</LinearLayout>
