<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/layoutProfileMenuItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/bg_profile_menu_item"
        android:clickable="true"
        android:elevation="1dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="58dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="18dp"
        android:paddingBottom="12dp"
        android:translationZ="1dp">

    <FrameLayout
            android:id="@+id/iconProfileMenuContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_profile_avatar">

        <ImageView
                android:id="@+id/imageProfileMenuIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/fitto_green" />

    </FrameLayout>

    <TextView
            android:id="@+id/textProfileMenuTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="@color/profile_text"
            android:textSize="16sp"
            android:textStyle="bold" />

</LinearLayout>