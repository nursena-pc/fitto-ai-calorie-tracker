<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fitto_bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

    <TextView
            android:id="@+id/titleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/logmeal_candidates_title"
            android:textColor="@color/fitto_text_dark"
            android:textSize="21sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/logmeal_candidates_subtitle"
            android:textColor="@color/fitto_text_secondary"
            android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/candidatesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="14dp"
            android:overScrollMode="never"
            tools:itemCount="4"
            tools:listitem="@layout/item_logmeal_candidate" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/addSelectedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/fitto_green"
            android:text="@string/logmeal_candidates_add_selected"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="17dp" />

    <com.google.android.material.button.MaterialButton
            android:id="@+id/manualSearchButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="@string/logmeal_candidates_manual_search"
            android:textAllCaps="false"
            android:textColor="@color/fitto_green" />

</LinearLayout>