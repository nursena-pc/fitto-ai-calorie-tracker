<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light">

    <!-- Üst Bar (Logo, Arama, Bildirim ve Mesajlar) -->
    <LinearLayout
            android:id="@+id/socialTopBar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <ImageView
                android:id="@+id/socialLogoImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/fitto1_icon" />

        <TextView
                android:id="@+id/socialLogoText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:fontFamily="@font/fredoka_bold"
                android:text="@string/app_name"
                android:textColor="@color/fitto_green"
                android:textSize="30sp"
                android:textStyle="bold" />

        <ImageButton
                android:id="@+id/socialSearchButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_search"
                app:tint="@color/fitto_text_dark" />

        <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

            <ImageButton
                    android:id="@+id/socialNotificationsButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/social_notifications"
                    android:src="@drawable/ic_notifications"
                    app:tint="@color/fitto_text_dark" />

            <TextView
                    android:id="@+id/socialNotificationsBadgeText"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_unread_badge"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

        </FrameLayout>

        <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

            <ImageButton
                    android:id="@+id/socialMessagesButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_messages"
                    app:tint="@color/fitto_text_dark" />

            <TextView
                    android:id="@+id/socialMessagesBadgeText"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_unread_badge"
                    android:gravity="center"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Gönderi Listesi -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/socialSwipeRefreshLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/socialTopBar">

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/socialPostsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="112dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Hızlı Gönderi Oluşturma Butonu (FAB) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/socialFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:src="@drawable/ic_add"
            android:visibility="gone"
            app:backgroundTint="@color/fitto_green"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>