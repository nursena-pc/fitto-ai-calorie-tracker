<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/languagePopupRoot"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_language_popup"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

    <LinearLayout
            android:id="@+id/turkishOption"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

        <RadioButton
                android:id="@+id/turkishRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/language_turkish"
                android:textColor="@color/fitto_text_dark"
                android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
            android:id="@+id/englishOption"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

        <RadioButton
                android:id="@+id/englishRadio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/language_english"
                android:textColor="@color/fitto_text_dark"
                android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>