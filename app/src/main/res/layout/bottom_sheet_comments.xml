<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/commentsBottomSheetRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fitto_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

    <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_action_panel" />

    <TextView
            android:id="@+id/commentsTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/social_comments"
            android:textColor="@color/fitto_text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/noCommentsText"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="center"
            android:text="@string/social_no_comments"
            android:textColor="@color/fitto_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/commentsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxHeight="420dp"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="never" />

    <LinearLayout
            android:id="@+id/replyingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_replying_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

        <TextView
                android:id="@+id/replyingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/fitto_green"
                android:textSize="13sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/cancelReplyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/social_cancel_reply"
                android:textColor="@color/fitto_green"
                android:textSize="13sp"
                android:textStyle="bold" />

    </LinearLayout>

    <LinearLayout
            android:id="@+id/commentInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/commentInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/fitto_green"
                app:hintTextColor="@color/fitto_green">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/commentEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/social_write_comment"
                    android:imeOptions="actionSend"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:minLines="1"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp">

            <ImageButton
                    android:id="@+id/sendCommentButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/social_send"
                    android:padding="12dp"
                    android:src="@drawable/ic_send"
                    app:tint="@color/fitto_green" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/sendCommentProgress"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/fitto_green"
                    app:trackColor="@android:color/transparent" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>