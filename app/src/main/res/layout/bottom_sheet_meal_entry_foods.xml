<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fitto_bottom_sheet"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

    <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_fitto_bottom_sheet_handle" />

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Kahvaltı" />

            <TextView
                    android:id="@+id/subtitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/fitto_text_secondary"
                    android:textSize="13sp"
                    tools:text="Bu öğündeki besinleri düzenle" />
        </LinearLayout>

        <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/common_cancel"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                app:tint="@color/fitto_text_secondary" />
    </LinearLayout>

    <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_add_meal_selected_card"
            android:gravity="center"
            android:padding="18dp"
            android:text="@string/meal_entry_foods_empty"
            android:textColor="@color/fitto_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/foodsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:itemCount="3"
            tools:listitem="@layout/item_meal_entry_food" />

</LinearLayout>