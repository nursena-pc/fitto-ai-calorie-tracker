<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/chatMessageRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

    <!-- Gönderici Adı -->
    <TextView
            android:id="@+id/chatSenderText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="46dp"
            android:textSize="11sp"
            android:visibility="gone" />

    <LinearLayout
            android:id="@+id/chatMessageRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <FrameLayout
                android:id="@+id/chatMessageAvatarContainer"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_primary_soft"
                android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/chatMessageAvatarImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Fitto.Circle" />

            <!-- EKSİK OLAN 1: Avatar Baş Harf Metni -->
            <TextView
                    android:id="@+id/chatMessageAvatarInitialText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/fitto_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />
        </FrameLayout>
        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/chatMessageImagePreview"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_marginBottom="6dp"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        <TextView
                android:id="@+id/chatMessageBubbleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="280dp"
                android:textSize="15sp" />
    </LinearLayout>

    <!-- EKSİK OLAN 2: Meta Bilgi Satırı (Saat ve Okundu Bilgisi) -->
    <LinearLayout
            android:id="@+id/chatMessageMetaRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="46dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <TextView
                android:id="@+id/chatMessageTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fitto_text_secondary"
                android:textSize="11sp" />

        <!-- EKSİK OLAN 3: Okundu Bilgisi Metni -->
        <TextView
                android:id="@+id/chatMessageReadReceiptText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/fitto_green"
                android:textSize="11sp"
                android:visibility="gone" />
    </LinearLayout>
</LinearLayout>