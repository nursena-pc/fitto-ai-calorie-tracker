<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/targetWeightReasonRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fitto_bottom_sheet"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <View
                android:layout_width="48dp"
                android:layout_height="5dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_fitto_bottom_sheet_handle" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_fitto_circle_soft"
                    android:contentDescription="@string/target_weight_ai_reason_title"
                    android:padding="9dp"
                    android:src="@drawable/ic_auto_awesome"
                    app:tint="@color/fitto_green" />

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/target_weight_ai_reason_title"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_fitto_pill_soft_green"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/target_weight_ai_badge"
                    android:textColor="@color/fitto_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

        </LinearLayout>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:text="@string/target_weight_ai_reason_description"
                android:textColor="@color/fitto_text_secondary"
                android:textSize="15sp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal">

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_target_weight_reason_metric_blue"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="5dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="8dp">

                <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_fitto_circle_soft"
                        android:padding="7dp"
                        android:src="@drawable/ic_profile_person"
                        app:tint="@color/tag_chip_blue_text" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/target_weight_ai_reason_current_selection"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="10sp" />

                <TextView
                        android:id="@+id/targetWeightReasonCurrentWeightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:autoSizeMaxTextSize="17sp"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/tag_chip_blue_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:visibility="gone"
                        android:text="@string/target_weight_ai_reason_current_selection_caption"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_target_weight_reason_metric_green"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="5dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="8dp">

                <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_fitto_circle_soft"
                        android:padding="7dp"
                        android:src="@drawable/ic_auto_awesome"
                        app:tint="@color/fitto_green" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/target_weight_ai_reason_recommendation"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="10sp" />

                <TextView
                        android:id="@+id/targetWeightReasonAiWeightText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:autoSizeMaxTextSize="17sp"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/fitto_green"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:visibility="gone"
                        android:text="@string/target_weight_ai_reason_recommendation_caption"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="10sp" />

            </LinearLayout>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="116dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_target_weight_reason_metric_purple"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="5dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="5dp"
                    android:paddingBottom="8dp">

                <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_fitto_circle_soft"
                        android:padding="7dp"
                        android:src="@drawable/ic_schedule"
                        app:tint="@color/tag_chip_purple_text" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/target_weight_ai_reason_duration"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="10sp" />

                <TextView
                        android:id="@+id/targetWeightReasonDurationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:autoSizeMaxTextSize="17sp"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:textColor="@color/tag_chip_purple_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:visibility="gone"
                        android:text="@string/target_weight_ai_reason_duration_caption"
                        android:textColor="@color/fitto_text_secondary"
                        android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/target_weight_ai_reason_inputs_title"
                android:textColor="@color/fitto_text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp">

            <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_weight_ai_reason_input_current_weight"
                    android:textSize="11sp"
                    app:chipMinHeight="34dp"
                    app:chipBackgroundColor="@color/fitto_chip_background"
                    app:chipIcon="@drawable/ic_monitor_weight"
                    app:chipIconTint="@color/fitto_green" />

            <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_weight_ai_reason_input_height"
                    android:textSize="11sp"
                    app:chipMinHeight="34dp"
                    app:chipBackgroundColor="@color/fitto_chip_background"
                    app:chipIcon="@drawable/ic_straighten"
                    app:chipIconTint="@color/fitto_green" />

            <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_weight_ai_reason_input_age"
                    android:textSize="11sp"
                    app:chipMinHeight="34dp"
                    app:chipBackgroundColor="@color/fitto_chip_background"
                    app:chipIcon="@drawable/ic_calendar_today"
                    app:chipIconTint="@color/fitto_green" />

            <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_weight_ai_reason_input_gender"
                    android:textSize="11sp"
                    app:chipMinHeight="34dp"
                    app:chipBackgroundColor="@color/fitto_chip_background"
                    app:chipIcon="@drawable/ic_profile_person"
                    app:chipIconTint="@color/fitto_green" />

            <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_weight_ai_reason_input_activity"
                    android:textSize="11sp"
                    app:chipMinHeight="34dp"
                    app:chipBackgroundColor="@color/fitto_chip_background"
                    app:chipIcon="@drawable/ic_fitness"
                    app:chipIconTint="@color/fitto_green" />

            <com.google.android.material.chip.Chip
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/target_weight_ai_reason_input_goal"
                    android:textSize="11sp"
                    app:chipMinHeight="34dp"
                    app:chipBackgroundColor="@color/fitto_chip_background"
                    app:chipIcon="@drawable/ic_bullseye_arrow"
                    app:chipIconTint="@color/fitto_green" />

        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_target_weight_reason_panel"
                android:gravity="top"
                android:orientation="horizontal"
                android:padding="14dp">

            <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_fitto_circle_soft"
                    android:padding="10dp"
                    android:src="@drawable/ic_auto_awesome"
                    app:tint="@color/fitto_green" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/target_weight_ai_reason_evaluation_title"
                        android:textColor="@color/fitto_green"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/targetWeightReasonEvaluationText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/targetWeightReasonUseAiButton"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:includeFontPadding="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:text="@string/target_weight_ai_use_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/fitto_green"
                app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/targetWeightReasonContinueOwnButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:text="@string/target_weight_ai_continue_own_target"
                android:textAllCaps="false"
                android:textColor="@color/fitto_green"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="@color/fitto_green" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
