<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/profileSummaryContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp">

    <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeeklySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/profile_card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/profile_stroke"
            app:strokeWidth="1dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textWeeklySummaryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/profile_weekly_summary"
                        android:textColor="@color/profile_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/textWeeklySummaryPeriodChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_fitto_pill_soft_green"
                        android:includeFontPadding="false"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="@string/profile_weekly_summary_period"
                        android:textColor="@color/fitto_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textWeeklySummarySubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:includeFontPadding="false"
                    android:text="@string/profile_weekly_summary_source"
                    android:textColor="@color/profile_subtext"
                    android:textSize="13sp" />

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/fitto_surface_soft"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/profile_stroke"
                        app:strokeWidth="1dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                        <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/profile_weekly_summary_recorded_days"
                                android:textColor="@color/profile_subtext"
                                android:textSize="11sp" />

                        <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/textWeeklyRecordedDaysValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/profile_text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/fitto_surface_soft"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/profile_stroke"
                        app:strokeWidth="1dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                        <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/profile_weekly_summary_total"
                                android:textColor="@color/profile_subtext"
                                android:textSize="11sp" />

                        <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/textWeeklyTotalCaloriesValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/profile_text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/fitto_surface_soft"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/profile_stroke"
                        app:strokeWidth="1dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                        <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/profile_weekly_summary_average"
                                android:textColor="@color/profile_subtext"
                                android:textSize="11sp" />

                        <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/textWeeklyAverageCaloriesValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/profile_text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="76dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/fitto_surface_soft"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/profile_stroke"
                        app:strokeWidth="1dp">

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="8dp">

                        <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/profile_weekly_summary_today"
                                android:textColor="@color/profile_subtext"
                                android:textSize="11sp" />

                        <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/textWeeklyTodayCaloriesValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/profile_text"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                <com.example.fitto.feature_home.presentation.profile.view.ProfileDonutChartView
                        android:id="@+id/profileDonutChart"
                        android:layout_width="114dp"
                        android:layout_height="114dp" />

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/profile_weekly_summary_macro_distribution"
                            android:textColor="@color/profile_text"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/textWeeklyMacroTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/profile_subtext"
                            android:textSize="12sp" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@color/reports_macro_protein" />

                        <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/daily_macro_protein_label"
                                android:textColor="@color/profile_text"
                                android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/textWeeklyProteinValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="@color/profile_subtext"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                    </LinearLayout>

                    <ProgressBar
                            android:id="@+id/progressWeeklyProtein"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="5dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/reports_macro_protein"
                            android:progressBackgroundTint="@color/profile_progress_track" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@color/reports_macro_carbs" />

                        <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/daily_macro_carbs_label"
                                android:textColor="@color/profile_text"
                                android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/textWeeklyCarbsValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="@color/profile_subtext"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                    </LinearLayout>

                    <ProgressBar
                            android:id="@+id/progressWeeklyCarbs"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="5dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/reports_macro_carbs"
                            android:progressBackgroundTint="@color/profile_progress_track" />

                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@color/reports_macro_fat" />

                        <com.google.android.material.textview.MaterialTextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/daily_macro_fat_label"
                                android:textColor="@color/profile_text"
                                android:textSize="12sp" />

                        <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/textWeeklyFatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="@color/profile_subtext"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                    </LinearLayout>

                    <ProgressBar
                            android:id="@+id/progressWeeklyFat"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="6dp"
                            android:layout_marginTop="5dp"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/reports_macro_fat"
                            android:progressBackgroundTint="@color/profile_progress_track" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textWeeklySummaryHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_fitto_pill_soft_green"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="9dp"
                    android:text="@string/profile_weekly_summary_open_reports_hint"
                    android:textColor="@color/fitto_green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGoals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/profile_card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/profile_stroke"
            app:strokeWidth="1dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textGoalsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/profile_goals"
                    android:textColor="@color/profile_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textWeeklyProgressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:includeFontPadding="false"
                    android:text=""
                    android:textColor="@color/profile_text"
                    android:textSize="14sp" />

            <ProgressBar
                    android:id="@+id/progressWeekly"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="7dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_profile_progress_bar" />

            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textWaterProgressLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:includeFontPadding="false"
                    android:text="@string/profile_water_goal"
                    android:textColor="@color/profile_text"
                    android:textSize="14sp" />

            <ProgressBar
                    android:id="@+id/progressWater"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="7dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_profile_progress_bar" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
