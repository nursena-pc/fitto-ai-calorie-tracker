<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/regionRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

    <include
            android:id="@+id/onboardingProgressContainer"
            layout="@layout/view_onboarding_progress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />



    <ImageButton
            android:id="@+id/regionBackButton"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_circle_primary_soft"
            android:contentDescription="@string/back"
            android:padding="18dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/fitto_green"
            app:layout_constraintTop_toBottomOf="@id/onboardingProgressContainer"
            app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
            android:id="@+id/regionContentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingBottom="64dp"
            app:layout_constraintTop_toBottomOf="@id/regionBackButton"
            app:layout_constraintBottom_toTopOf="@id/regionNextButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <TextView
                android:id="@+id/regionTitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/region_title"
                android:textColor="@color/fitto_text_dark"
                android:textSize="28sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/regionDescriptionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="5dp"
                android:text="@string/region_description"
                android:textColor="#666A6D"
                android:textSize="18sp" />

        <LinearLayout
                android:id="@+id/primaryRegionCard"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="42dp"
                android:background="@drawable/bg_fitto_card_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

            <TextView
                    android:id="@+id/primaryRegionFlagText"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_fitto_circle_soft"
                    android:gravity="center"
                    android:text="🇹🇷"
                    android:textSize="24sp" />

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                        android:id="@+id/primaryRegionTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/region_suggested_turkey"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/primaryRegionSubtitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/region_recommended"
                        android:textColor="@color/fitto_green"
                        android:textSize="14sp" />

            </LinearLayout>

            <FrameLayout
                    android:id="@+id/primaryRegionCheckContainer"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_fitto_circle_check">

                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check_white" />

            </FrameLayout>

        </LinearLayout>

        <LinearLayout
                android:id="@+id/otherRegionCard"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_fitto_card_normal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

            <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_fitto_circle_soft">

                <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_public"
                        app:tint="@color/fitto_green" />

            </FrameLayout>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                        android:id="@+id/otherRegionTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/region_other"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <TextView
                        android:id="@+id/otherRegionSubtitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/region_other_subtitle"
                        android:textColor="#6E7376"
                        android:textSize="13sp" />

            </LinearLayout>

            <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_chevron_right_dark" />

        </LinearLayout>

    </LinearLayout>

    <TextView
            android:id="@+id/regionNextButton"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginBottom="58dp"
            android:background="@drawable/bg_fitto_button_primary"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/next"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>