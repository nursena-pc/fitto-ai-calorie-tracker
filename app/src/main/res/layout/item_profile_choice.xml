<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/layoutProfileChoiceItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_profile_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="54dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="13dp"
        android:paddingEnd="16dp"
        android:paddingBottom="13dp">

    <TextView
            android:id="@+id/textChoiceTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:textColor="@color/profile_text"
            android:textSize="16sp"
            android:textStyle="bold" />

    <TextView
            android:id="@+id/textChoiceCheck"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="✓"
            android:textColor="@color/fitto_green"
            android:textSize="20sp"
            android:textStyle="bold" />

</LinearLayout>