<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/remindersScreenRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/profile_screen_background">

    <androidx.core.widget.NestedScrollView
            android:id="@+id/remindersScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

        <LinearLayout
                android:id="@+id/remindersRootLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

            <FrameLayout
                    android:id="@+id/remindersTopBar"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp">

                <TextView
                        android:id="@+id/buttonReminderBack"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="start|center_vertical"
                        android:background="@drawable/bg_reminder_circle_button"
                        android:gravity="center"
                        android:text="‹"
                        android:textColor="@color/fitto_green"
                        android:textSize="38sp"
                        android:textStyle="bold" />

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                    <TextView
                            android:id="@+id/textReminderTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_menu_reminders"
                            android:textColor="@color/profile_text"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/textReminderActiveCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/profile_subtext"
                            android:textSize="16sp" />
                </LinearLayout>
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReminderPlan"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    app:cardBackgroundColor="@color/reminder_hero_green"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="4dp">

                <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="14dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="14dp">

                    <com.example.fitto.feature_home.presentation.profile.view.ReminderPlanClockView
                            android:id="@+id/reminderPlanClockView"
                            android:layout_width="226dp"
                            android:layout_height="226dp"
                            android:layout_gravity="start|center_vertical" />

                    <LinearLayout
                            android:id="@+id/layoutPlanInfoCard"
                            android:layout_width="120dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|top"
                            android:background="@drawable/bg_reminder_plan_info"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="11dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="11dp">

                        <TextView
                                android:id="@+id/textPlanInfoIcon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:textSize="18sp" />

                        <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                            <TextView
                                    android:id="@+id/textPlanInfoLabel"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/fitto_white"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                            <TextView
                                    android:id="@+id/textPlanInfoTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="none"
                                    android:maxLines="3"
                                    android:textColor="@color/fitto_white"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:scrollHorizontally="false"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                            android:id="@+id/textPlanSelectedInfo"
                            android:layout_width="132dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|bottom"
                            android:layout_marginBottom="28dp"
                            android:gravity="center"
                            android:textColor="@color/fitto_white"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="invisible" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView
                    android:id="@+id/scrollReminderChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupReminders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipReminderAll"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_filter_all"
                            android:textColor="@color/profile_text"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/reminder_chip_all" />

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipReminderMeal"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_tag_meal"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/reminder_meal_soft" />

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipReminderWater"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_tag_water"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/reminder_water_soft" />

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipReminderExercise"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_tag_exercise"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/reminder_exercise_soft" />

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipReminderWeight"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_tag_weight"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/reminder_weight_soft" />

                    <com.google.android.material.chip.Chip
                            android:id="@+id/chipReminderCustom"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/reminder_tag_custom"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="@color/reminder_custom_soft" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerProfileReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_profile_reminder" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAddReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="22dp"
            android:layout_marginBottom="26dp"
            android:textColor="@color/fitto_white"
            app:backgroundTint="@color/fitto_green"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/fitto_white" />
</FrameLayout>