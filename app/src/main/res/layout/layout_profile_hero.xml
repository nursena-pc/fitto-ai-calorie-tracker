<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/profileHeroContainer"
        android:layout_width="match_parent"
        android:layout_height="260dp">

    <com.example.fitto.feature_home.presentation.profile.view.ProfileHeroBackgroundView
            android:id="@+id/profileHeroBackground"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="32dp" />

    <LinearLayout
            android:id="@+id/layoutFittoWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:id="@+id/profileLogoImage"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/fitto1_icon" />

        <TextView
                android:id="@+id/profileLogoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/fredoka_bold"
                android:includeFontPadding="false"
                android:text="@string/app_name"
                android:textColor="@color/fitto_green"
                android:textSize="30sp"
                android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp">

        <ImageView
                android:id="@+id/buttonProfileNotifications"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:clickable="true"
                android:contentDescription="@string/profile_menu_notifications"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notifications"
                app:tint="@color/fitto_green" />

        <TextView
                android:id="@+id/profileNotificationBadgeText"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_unread_badge"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
            android:id="@+id/profileHeroContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="34dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

        <ImageView
                android:id="@+id/imageProfileAvatar"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginTop="34dp"
                android:background="@drawable/bg_profile_avatar"
                android:clickable="true"
                android:contentDescription="@string/profile_photo"
                android:focusable="true"
                android:padding="6dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_person" />

        <TextView
                android:id="@+id/textProfileUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text=""
                android:visibility="invisible"
                android:textColor="@color/profile_text"
                android:textSize="24sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/textProfileProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:includeFontPadding="false"
                android:text=""
                android:visibility="invisible"
                android:textColor="@color/profile_subtext"
                android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>