<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/weightLossReasonRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fitto_background_light"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

    <include
            android:id="@+id/onboardingProgressContainer"
            layout="@layout/view_onboarding_progress"
            android:layout_width="0dp"
            android:layout_height="6dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
            android:id="@+id/reasonBackButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_fitto_circle_soft"
            android:contentDescription="@string/back"
            android:padding="18dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/fitto_green"
            app:layout_constraintTop_toBottomOf="@id/onboardingProgressContainer"
            app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
            android:id="@+id/reasonScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="26dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="92dp"
            app:layout_constraintTop_toBottomOf="@id/reasonBackButton"
            app:layout_constraintBottom_toTopOf="@id/reasonNextButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:id="@+id/reasonContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/reasonTitleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/reason_title"
                    android:textColor="@color/fitto_text_dark"
                    android:textSize="25sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/reasonDescriptionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="@string/reason_desc"
                    android:textColor="#666A6D"
                    android:textSize="18sp" />

            <LinearLayout
                    android:id="@+id/reasonOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:orientation="vertical">

                <LinearLayout
                        android:id="@+id/reasonWeddingCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_wedding" />

                    <FrameLayout
                            android:id="@+id/reasonWeddingCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonGraduationCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_graduation" />

                    <FrameLayout
                            android:id="@+id/reasonGraduationCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonHolidayCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_holiday" />

                    <FrameLayout
                            android:id="@+id/reasonHolidayCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonLookFitterCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_look_fitter" />

                    <FrameLayout
                            android:id="@+id/reasonLookFitterCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonImproveHealthCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_improve_health" />

                    <FrameLayout
                            android:id="@+id/reasonImproveHealthCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonMoreEnergyCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_more_energy" />

                    <FrameLayout
                            android:id="@+id/reasonMoreEnergyCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonClothesCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_clothes" />

                    <FrameLayout
                            android:id="@+id/reasonClothesCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonDoctorCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_doctor" />

                    <FrameLayout
                            android:id="@+id/reasonDoctorCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonFeelBetterCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_feel_better" />

                    <FrameLayout
                            android:id="@+id/reasonFeelBetterCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                        android:id="@+id/reasonOtherCard"
                        style="@style/Widget_Fitto_BarrierCard">

                    <TextView
                            style="@style/Widget_Fitto_BarrierText"
                            android:text="@string/reason_other" />

                    <FrameLayout
                            android:id="@+id/reasonOtherCheck"
                            style="@style/Widget_Fitto_BarrierCheck">

                        <ImageView style="@style/Widget_Fitto_BarrierCheckIcon" />
                    </FrameLayout>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                    android:id="@+id/reasonEventDateContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_fitto_card"
                    android:elevation="2dp"
                    android:orientation="vertical"
                    android:padding="18dp"
                    android:visibility="gone">

                <TextView
                        android:id="@+id/reasonEventDateTitleText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/event_date"
                        android:textColor="@color/fitto_text_dark"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                <LinearLayout
                        android:id="@+id/reasonEventDateButton"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_fitto_input"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                    <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_calendar_today"
                            app:tint="@color/fitto_green" />

                    <TextView
                            android:id="@+id/reasonEventDateText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:text="@string/select_date"
                            android:textColor="#7D8386"
                            android:textSize="17sp" />

                </LinearLayout>

                <TextView
                        android:id="@+id/reasonEventDateErrorText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/error_date_required"
                        android:textColor="#B3261E"
                        android:textSize="12sp"
                        android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <TextView
            android:id="@+id/reasonNextButton"
            android:layout_width="0dp"
            android:layout_height="68dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_fitto_button_primary"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/next"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>