<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/dialogFittoActionRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_profile_card"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp">

    <LinearLayout
            android:id="@+id/layoutActionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageView
                android:id="@+id/imageActionIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_swipe_delete"
                app:tint="@color/profile_subtext" />

        <TextView
                android:id="@+id/textActionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:includeFontPadding="false"
                android:textColor="@color/profile_text"
                android:textSize="18sp"
                android:textStyle="bold" />

    </LinearLayout>

    <TextView
            android:id="@+id/textActionMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/profile_subtext"
            android:textSize="14sp" />

    <TextView
            android:id="@+id/textActionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:includeFontPadding="false"
            android:textColor="@color/reminder_delete"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    <LinearLayout
            android:id="@+id/layoutPasswordArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

        <TextView
                android:id="@+id/textPasswordLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/profile_text"
                android:textSize="13sp"
                android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/profile_delete_account_password_hint"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/fitto_green"
                app:endIconMode="password_toggle"
                app:hintTextColor="@color/fitto_green">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editActionPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/profile_text"
                    android:textColorHint="@color/profile_subtext"
                    android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <LinearLayout
            android:id="@+id/layoutActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonActionCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="72dp"
                android:text="@string/profile_delete_account_cancel"
                android:textAllCaps="false"
                android:textColor="@color/fitto_green"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonActionConfirm"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:minWidth="92dp"
                android:text="@string/profile_delete_account_confirm"
                android:textAllCaps="false"
                android:textColor="@color/profile_subtext"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

    </LinearLayout>

</LinearLayout>