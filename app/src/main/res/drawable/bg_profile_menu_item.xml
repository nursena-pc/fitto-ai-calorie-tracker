<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/profile_card_background" />
            <corners android:radius="18dp" />
            <stroke
                    android:width="1dp"
                    android:color="@color/fitto_green" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/profile_menu_background" />
            <corners android:radius="18dp" />
            <stroke
                    android:width="1dp"
                    android:color="@color/profile_stroke" />
        </shape>
    </item>

</selector>