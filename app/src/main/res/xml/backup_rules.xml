<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Account-scoped health, nutrition, authentication, and notification state must not leave
         the application sandbox through legacy Auto Backup. Remote data is restored by signing in. -->
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
